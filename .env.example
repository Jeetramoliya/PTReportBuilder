# Copy this file to `.env` and fill in the values. `.env` is git-ignored (never committed).
# On a host (Render/Fly/etc.) set these in the dashboard instead of using a .env file.

# --- Database (production) ---
# Turso/libSQL URL + token. If unset, the app uses a local SQLite file under DATA_DIR.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Only used for the local SQLite fallback (where $DATA_DIR/data/vapt.db lives).
DATA_DIR=

# --- Runtime ---
PORT=4173
NODE_ENV=development

# --- Admin / owner accounts ---
# Comma-separated emails that get the admin panel. These accounts are always admin.
ADMIN_EMAILS=you@example.com
# If set together with ADMIN_EMAILS, missing admin accounts are seeded on boot with this
# password. (Otherwise just sign up with an admin email.)
ADMIN_PASSWORD=change-me

# --- Plans ---
# Max projects for free accounts (pro/admin are unlimited).
FREE_PROJECT_LIMIT=5

# --- Email (optional: enables welcome + password-reset emails) ---
# Create a free Resend account, verify a sender, then set these.
RESEND_API_KEY=
MAIL_FROM=BlackRoot VAPT <noreply@yourdomain.com>

# --- Puppeteer (containers only) ---
# Path to a system Chromium. The Dockerfile sets this to /usr/bin/chromium.
PUPPETEER_EXECUTABLE_PATH=
